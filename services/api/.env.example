# Runtime environment for the Sokra API.
SOKRA_ENVIRONMENT=development

# OpenRouter configuration for the future provider.
# The API key is optional in global settings. Set it locally when using OpenRouter.
# SOKRA_OPENROUTER_API_KEY=
SOKRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models have no default. Set the desired OpenRouter model IDs locally.
# SOKRA_OPENROUTER_CHAT_MODEL=
# SOKRA_OPENROUTER_EMBEDDING_MODEL=
SOKRA_OPENROUTER_TIMEOUT_SECONDS=30.0
# Extra retries after the initial request.
SOKRA_OPENROUTER_RETRIES=2
